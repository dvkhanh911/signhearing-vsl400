APP_ENV=development
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional: same SITE_URL as frontend for a custom domain. Vercel system URLs are fallback.
# SITE_URL=https://your-domain.example
API_HOST=127.0.0.1
API_PORT=8001
# Optional legacy database health check only; Supabase features use Auth/PostgREST.
DATABASE_URL=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Separate inference service; leave blank to disable. Never put the secret in NEXT_PUBLIC_*.
AI_API_URL=
AI_TOKEN_SECRET=
