{
  "name": "signhearing-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "sync:content": "node scripts/sync-content.mjs",
    "predev": "npm run sync:content",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "npm run sync:content",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src scripts tests *.json *.mjs *.ts",
    "format:check": "prettier --check src scripts tests *.json *.mjs *.ts",
    "test": "node --test tests/content.test.mjs",
    "test:http": "node --test tests/http.test.mjs",
    "test:deployment": "node --experimental-strip-types --test tests/deployment.test.mjs",
    "capture:features": "node scripts/capture-feature-guides.mjs",
    "test:features": "node tests/features.browser.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.66.0",
    "motion": "14.9.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
