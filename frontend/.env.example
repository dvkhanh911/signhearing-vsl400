# Optional public HTTPS origin for metadata; Vercel's actual deployment URL is used when blank.
SITE_URL=
# Optional server-only FastAPI URL. Leave blank for the frontend-only preview.
# Set to the real HTTPS backend origin once it is deployed, then redeploy.
BACKEND_URL=
# Local development only: BACKEND_URL=http://127.0.0.1:8001
# Never add database URLs, passwords or Vercel tokens to frontend environment variables.
