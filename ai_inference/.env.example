AI_DEVICE=cpu
# This deployment permits CPU Windows only.
SIFORMER_MODEL_ROOT=C:/Users/Admin/Desktop/demo/Vietnamese-Sign-Language/Siformer
MP_PYTHON=C:/Users/Admin/Desktop/demo/Vietnamese-Sign-Language/.venv-mp/Scripts/python.exe
